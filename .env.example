# ===== Topshiriqlar boti sozlamalari =====

# @BotFather dan olingan bot tokeni (MAJBURIY)
BOT_TOKEN=123456:ABC-DEF...

# Rahbar(lar)ning Telegram ID raqamlari. Vergul bilan ajrating.
# O'z ID'ingizni bilish uchun botga /id deb yozing.
MANAGER_IDS=111111111

# Topshiriqlar guruhi ID'si (rahbar shu yerga topshiriq yozadi)
# Guruh ID'sini bilish uchun botni guruhga qo'shib /id deb yozing.
TASKS_GROUP_ID=-1001111111111

# Ijro guruhi ID'si (xodimlar bajarilgan ishni shu yerga tashlaydi)
EXECUTION_GROUP_ID=-1002222222222

# Vaqt mintaqasi (muddatlar shu bo'yicha hisoblanadi)
TIMEZONE=Asia/Tashkent

# Ma'lumotlar bazasi fayli
DB_PATH=topshriq.db

# Muddatdan necha daqiqa oldin eslatma yuborilsin (vergul bilan bir nechta)
REMINDER_MINUTES=120,30

# Topshiriqlar kanali (guruh emas, alohida Telegram kanal bo'lsa)
# Guruh bo'lsa TASKS_GROUP_ID yetarli, bu ixtiyoriy
TASKS_CHANNEL_ID=

# ===== AI (sun'iy intellekt) sozlamalari =====

# --- Variant 1: Bepul — Mahalliy Ollama (tavsiya qilinadi) ---
# Ollama o'rnatish: https://ollama.ai
# Asosiy model yuklash:  ollama pull llama3
# Rasm o'qish modeli:    ollama pull llava  (ixtiyoriy, rasmlardagi jadvalni o'qiydi)
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_VISION_MODEL=llava

# --- Variant 2: Pullik — Anthropic Claude ---
# https://console.anthropic.com dan olinadi
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ===== KOMPYUTER AGENTI sozlamalari =====
# Avtonom kompyuter boshqaruv agenti (/kompyuter komandasi)
# Faqat OLLAMA_VISION_MODEL (yuqorida) kerak — u llava bo'lishi kerak
# pyautogui o'rnatish: pip install pyautogui pyperclip
# Linux da: sudo apt install python3-tk python3-dev scrot
# (DISPLAY o'zgaruvchisi kerak, headless serverlarda ishlaMaydi)

# ===== MINI APP (Telegram Web App) sozlamalari =====
# Xodimlar bot ichida "📱 Mini App" tugmasini bosib topshiriq yuklaydi.
#
# WEBAPP_URL — Mini Appning ommaviy HTTPS manzili (majburiy Mini App uchun)
# Sozlash yo'riqnomasi:
#   1. VPS yoki server oling
#   2. Domen nomi ulang (masalan: topshriq.example.com)
#   3. Let's Encrypt orqali SSL oling: sudo certbot --nginx -d topshriq.example.com
#   4. Nginx proksi:
#      location / { proxy_pass http://127.0.0.1:8080; }
#   5. Quyiga domenni yozing
WEBAPP_URL=https://topshriq.example.com
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# ===== USERBOT sozlamalari (shaxsiy eslatmalar uchun) =====
# Userbot — xodimlar shaxsiy chatiga eslatma yuborish (ixtiyoriy)
# 1. https://my.telegram.org saytiga kiring
# 2. "API development tools" bo'limida API ID va Hash oling
# 3. python generate_session.py buyrug'ini ishga tushiring
TG_API_ID=
TG_API_HASH=
TG_USERBOT_SESSION=
